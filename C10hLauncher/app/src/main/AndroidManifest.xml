<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.c10h.launcher"
    android:versionCode="61"
    android:versionName="1.60">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />

    <!-- 音效（模块 A） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING"
        tools:ignore="ProtectedPermissions" />
    <!-- 小组件（模块 B，本计划只声明不实现） -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />
    <!-- 自研设置（模块 E） -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <!-- 内存占用页：结束后台进程的回退路径 -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 自研应用信息（不依赖 com.android.settings） -->
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REVOKE_RUNTIME_PERMISSIONS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CLEAR_APP_USER_DATA"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.DELETE_CACHE_FILES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.GET_PACKAGE_SIZE" />
    <!-- 手势导航：截取当前屏幕做缩小/模糊动画（SurfaceControl.screenshot） -->
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER"
        tools:ignore="ProtectedPermissions" />
    <!-- 应用信息页：自研卸载（本机 packageinstaller 的 UninstallerActivity 对所有包
         都报 Package not found 并立即 finish，必须走 DELETE_PACKAGES 静默卸载） -->
    <uses-permission android:name="android.permission.DELETE_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <!-- 自研最近任务（不依赖 SystemUI Recents） -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.GET_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REMOVE_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.SET_TIME"
        tools:ignore="ProtectedPermissions" />
    <!-- 熄屏：PowerManager.goToSleep 需要 DEVICE_POWER（platform 签名自动授予） -->
    <uses-permission android:name="android.permission.DEVICE_POWER"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 安装器（模块 D） -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- 悬浮导航（模块 C） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INJECT_EVENTS"
        tools:ignore="ProtectedPermissions" />
    <!-- 模块 G（normal 级，manifest 声明即得） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 真息屏 + 后台保活：先持 partial wake lock 阻止 suspend，再 goToSleep 关显示 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- persistent 属性保留（系统内路径生效、/data 安装被框架忽略，无害）。
         保活不依赖它：HOME 身份开机自拉 + 各模块自愈（评审 S3）。 -->
    <application
        android:name="com.c10h.launcher.LauncherApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:persistent="true"
        android:usesCleartextTraffic="true"
        tools:ignore="ProtectedPermissions">

        <activity
            android:name="com.c10h.launcher.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/LauncherTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 模块 D：文件管理器 + 安装器（:installer 进程，崩溃只死自身，规格 §3/§8） -->
        <activity
            android:name="com.c10h.launcher.FileBrowserActivity"
            android:exported="true"
            android:label="文件管理"
            android:process=":installer"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/LauncherTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.c10h.launcher.InstallerActivity"
            android:exported="true"
            android:process=":installer"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/LauncherTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>

        <!-- 模块 E：自研设置（:settings 进程，崩溃只死自身，规格 §9） -->
        <activity
            android:name="com.c10h.launcher.settings.SettingsActivity"
            android:exported="true"
            android:label="C10H 设置"
            android:process=":settings"
            android:taskAffinity="com.c10h.launcher.settings"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/SettingsTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.c10h.launcher.settings.LauncherSettingsActivity"
            android:exported="true"
            android:process=":settings"
            android:taskAffinity="com.c10h.launcher.settings"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/SettingsTheme" />

        <activity
            android:name="com.c10h.launcher.settings.AppInfoActivity"
            android:exported="true"
            android:process=":settings"
            android:taskAffinity="com.c10h.launcher.settings"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/SettingsTheme" />

        <activity
            android:name="com.c10h.launcher.settings.UpdateActivity"
            android:exported="false"
            android:process=":settings"
            android:taskAffinity="com.c10h.launcher.settings"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/SettingsTheme" />

        <activity
            android:name="com.c10h.launcher.settings.RecentsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="com.c10h.launcher.settings"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/RecentsTheme" />

        <activity
            android:name="com.c10h.launcher.AppDrawerActivity"
            android:exported="true"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/LauncherTheme" />

        <!-- 均衡器宿主：必须在主进程，才能拿到持有 DynamicsProcessing 的 EqEngine。 -->
        <activity
            android:name="com.c10h.launcher.EqActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@style/EqDialogTheme" />

        <!-- 模块 G：屏蔽 + ADB 守护（:block 进程，补充文档 D1/D2；崩溃=fail-open 不断网） -->
        <service
            android:name="com.c10h.launcher.block.BlockVpnService"
            android:exported="true"
            android:process=":block"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.c10h.launcher.block.BootReceiver"
            android:exported="true"
            android:process=":block">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.c10h.launcher.UpdateReceiver"
            android:exported="true"
            android:process=":update">
            <intent-filter>
                <action android:name="com.c10h.launcher.action.UPDATE" />
            </intent-filter>
        </receiver>

        <!-- 模块 G 角标（规格 §6.9）：:badge 进程 NLS，崩溃只丢角标；广播回主进程渲染 -->
        <service
            android:name="com.c10h.launcher.badge.BadgeListenerService"
            android:exported="true"
            android:process=":badge"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
